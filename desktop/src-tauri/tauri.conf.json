{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadlyne",
  "version": "0.1.1",
  "identifier": "app.deadlyne.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deadlyne",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1b1b1b",
        "dragDropEnabled": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Photography",
    "shortDescription": "Instant RAW culling and captioning for sports photographers",
    "copyright": "\u00a9 2026 Austyn McFadden",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "Deadlyne",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5RUIzNjY4QUE5MDJDREUKUldUZUxKQ3FhRGJyeWRQMHZFcFZsTjlEZW1oMm5haTRSb081Tmx0amJrV2tGSHVhTlNxZXpjSFMK",
      "endpoints": [
        "https://github.com/austynundrafted-lgtm/deadlyne/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}